<section id="pull-request-approvals" class="approval-editor" data-approval-state="{{JsonUtils.EncodeToString .BranchApprovals}}" data-approval-choices="{{JsonUtils.EncodeToString .ApprovalChoices}}" data-project-link="{{.ApprovalProjectLink}}" data-repository-mode="{{if .ApprovalRepositoryMode}}true{{else}}false{{end}}">
 <div class="tw-flex tw-items-center tw-justify-between tw-gap-3 tw-flex-wrap">
  <h3 class="ui header tw-m-0">合并请求审批</h3>
  {{if .BranchApprovals.CanManage}}<button class="ui small primary button" type="button" data-approval-add>{{svg "octicon-plus" 16}} 添加审批规则</button>{{end}}
 </div>
 <p class="tw-text-text-light">每条必需规则都必须满足。同一人在一条规则内只计一票，符合多条规则时可以同时满足它们。</p>
 <div class="ui negative message tw-hidden" role="alert" data-approval-error></div>
 <div class="tw-overflow-x-auto"><table class="ui celled table"><thead><tr><th>审批规则</th><th>审批人／群组</th><th>所需人数</th><th>来源</th><th>操作</th></tr></thead><tbody data-approval-rows></tbody></table></div>
 <p class="tw-text-text-light" data-approval-empty hidden>暂无适用审批规则。可以添加总人数要求或指定人员、群组的审批要求。</p>
 {{if not .ApprovalRepositoryMode}}<p><a href="{{.ApprovalProjectLink}}">管理适用于多个分支的仓库规则</a></p>{{end}}
 <h3 class="ui dividing header">审批设置 <span class="ui small basic label">仓库级</span></h3>
 <p class="tw-text-text-light">以下设置影响本仓库所有分支；标有继承锁定的值需在来源处修改。</p>
 <div data-approval-settings class="tw-flex tw-flex-col tw-gap-3"></div>
 <input type="hidden" name="approval_configuration" value="{{JsonUtils.EncodeToString .ApprovalInitialUpdate}}" data-approval-payload>
 <noscript><p class="ui warning message">审批编辑需要启用 JavaScript；当前页面不能提交审批草稿。</p></noscript>
 <dialog data-approval-dialog class="approval-rule-dialog">
  <div class="ui form">
   <h3 class="ui dividing header" data-approval-dialog-title>添加审批规则</h3>
   <div class="two fields"><div class="field"><label for="approval-rule-name">规则名称</label><input id="approval-rule-name" maxlength="100" data-rule-name></div><div class="field"><label for="approval-rule-required">所需人数（0 为可选）</label><input id="approval-rule-required" type="number" min="0" max="100" value="1" data-rule-required></div></div>
   <div class="field"><label><input type="checkbox" data-rule-all> 全部合格审批人，按不同用户计算总人数</label></div>
   <div class="two fields">
    <div class="field"><label for="approval-rule-users">审批人</label><select id="approval-rule-users" multiple size="6" data-rule-users>{{range .ApprovalChoices.Users}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select></div>
    <div class="field"><label for="approval-rule-groups">群组／子群组（直接成员）</label><select id="approval-rule-groups" multiple size="6" data-rule-groups>{{range .ApprovalChoices.Groups}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select></div>
   </div>
   <div class="field" data-rule-scope-field><label for="approval-rule-scope">目标分支范围</label><select id="approval-rule-scope" data-rule-scope><option value="all">所有分支</option><option value="protected">所有保护分支</option><option value="protection_ids">指定保护规则（稳定关联）</option><option value="branches">指定保护分支</option></select><label for="approval-rule-protections">关联的保护规则（可多选）</label><select id="approval-rule-protections" multiple size="4" data-rule-protections>{{range .BranchApprovals.Protections}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select><label for="approval-rule-branches">分支或保护规则名称（每行一个）</label><textarea id="approval-rule-branches" rows="3" data-rule-branches></textarea></div>
   <div class="field"><label><input type="checkbox" checked data-rule-enabled> 启用此规则</label></div>
   <p class="tw-text-text-light" data-rule-legacy hidden>此规则兼容原生总人数及名单。将人数设为 0 可取消总人数要求；原有历史审批处理方式保留。</p>
   <p role="alert" data-rule-error class="tw-text-red"></p>
   <div class="tw-flex tw-justify-end tw-gap-2 tw-flex-wrap"><button type="button" class="ui button" data-rule-cancel>取消</button><button type="button" class="ui primary button" data-rule-apply>应用到草稿</button></div>
  </div>
 </dialog>
</section>
