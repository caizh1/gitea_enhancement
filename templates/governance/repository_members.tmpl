{{template "base/head" .}}
<div role="main" class="page-content governance repository-members"><div class="ui container tw-py-6">
 {{template "base/alert" .}}
 <h2>项目成员与来源 · {{.State.FullPath}}</h2>
 {{if .State.CanManage}}<a class="ui button" href="{{.InvitationPath}}">通过邮箱邀请成员</a>{{else}}<p class="ui info message">全站审计员只读查看成员来源，不能在此修改授权。</p>{{end}}
 <p>查看本项目全部明确授权来源。{{if .State.CanManage}}只能在此撤销项目直接授权；继承、共享、原生协作者及团队需要在各自来源处修改。{{end}}共享后的有效能力可能低于来源角色。</p>
 {{range .State.Members}}
  <div class="ui segment"><div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-flex-wrap"><strong>{{if .Username}}{{.Username}}{{else}}已删除用户 #{{.UserID}}{{end}}</strong>{{if not .Active}}<span class="ui label">账号不可用</span>{{end}}</div>
   {{if .Direct}}<p>直接角色：{{index $.RoleNames .Direct.Role}}{{if .Direct.CustomRoleID}} · 自定义角色 #{{.Direct.CustomRoleID}}{{end}} · {{if .Direct.ExpiresUnix}}{{DateUtils.FullTime .Direct.ExpiresUnix}}{{else}}永久{{end}}</p>{{end}}
   {{range .Grants}}<details class="tw-mt-2"><summary>{{index $.SourceNames .Source}} · 来源角色 {{index $.RoleNames .Role}}{{if .CeilingRole}} · 共享上限 {{index $.RoleNames .CeilingRole}}{{end}}{{if .ExpiresUnix}} · {{DateUtils.FullTime .ExpiresUnix}}{{end}}</summary><p>来源：{{if eq .ScopeType "group"}}群组{{else}}项目{{end}} #{{.ScopeID}}{{if eq .ScopeType "group"}}{{if index $.SourceGroups .ScopeID}} · <a href="{{AppSubUrl}}/governance/groups/{{.ScopeID}}">查看来源 {{index $.SourceGroups .ScopeID}}</a>{{end}}{{end}}{{if .ShareID}} · 共享关系 #{{.ShareID}}{{end}}{{if .NativeTeamID}} · 原生团队 #{{.NativeTeamID}}{{end}}</p><p>本来源实际能力：{{range $ability,$enabled := .Abilities}}{{if $enabled}}{{index $.AbilityNames $ability}}；{{end}}{{else}}无{{end}}</p></details>{{end}}
   {{range .NativeSources}}<div class="tw-mt-2">{{index $.NativeSourceNames .Kind}}{{if .TeamID}} #{{.TeamID}}{{end}} · {{.Access}}{{if .Units}}<details><summary>原生分单元权限</summary>{{range $name,$access := .Units}}<div>{{$name}}：{{$access}}</div>{{end}}</details>{{end}}</div>{{end}}
   {{if $.State.CanManage}}{{if .Direct}}<form method="post" class="tw-mt-3">{{$.CsrfTokenHtml}}<input type="hidden" name="user_id" value="{{.UserID}}"><input type="hidden" name="revision" value="{{$.State.Revision}}"><button class="ui red basic button" name="action" value="remove">撤销项目直接授权</button></form>{{else}}<p>本用户没有项目直接授权，请在上述来源处修改。</p>{{end}}{{end}}
  </div>
 {{else}}<p>暂无明确成员授权来源。</p>{{end}}
 {{if .State.NextID}}<a class="ui button" href="?after_id={{.State.NextID}}">下一页成员</a>{{end}}
 {{if .State.CanManageRoles}}<section class="ui segment"><h3>个人命名空间自定义角色</h3><p>跨顶级群组转入个人命名空间时，附加能力映射到这里的个人命名空间角色。</p>
  {{range .State.Roles}}<details class="ui segment"><summary>{{.Name}} · {{index $.RoleNames .BaseRole}}</summary><form class="ui form tw-mt-3" method="post" action="{{AppSubUrl}}/governance/repositories/{{$.State.RepoID}}/roles">{{$.CsrfTokenHtml}}<input type="hidden" name="role_id" value="{{.ID}}"><input type="hidden" name="revision" value="{{$.State.Revision}}"><input type="hidden" name="base_role" value="{{.BaseRole}}"><div class="field"><label>名称<input name="name" value="{{.Name}}" maxlength="100" required></label></div><fieldset class="field"><legend>附加能力</legend><div class="tw-flex tw-flex-wrap tw-gap-3">{{$selected := .Abilities}}{{range $ability,$name := $.AbilityNames}}<label class="tw-inline-flex tw-items-center tw-gap-2"><input type="checkbox" name="abilities" value="{{$ability}}" {{if SliceUtils.Contains $selected $ability}}checked{{end}}>{{$name}}</label>{{end}}</div></fieldset><button class="ui primary button">保存</button><button class="ui red basic button" name="action" value="remove">删除未使用角色</button></form></details>{{end}}
  <details><summary>创建个人命名空间角色</summary><form class="ui form tw-mt-3" method="post" action="{{AppSubUrl}}/governance/repositories/{{.State.RepoID}}/roles">{{.CsrfTokenHtml}}<input type="hidden" name="revision" value="{{.State.Revision}}"><div class="field"><label>名称<input name="name" maxlength="100" required></label></div><div class="field"><label>基础角色<select name="base_role">{{range $role,$name := .RoleNames}}<option value="{{$role}}">{{$name}}</option>{{end}}</select></label></div><fieldset class="field"><legend>附加能力</legend><div class="tw-flex tw-flex-wrap tw-gap-3">{{range $ability,$name := .AbilityNames}}<label class="tw-inline-flex tw-items-center tw-gap-2"><input type="checkbox" name="abilities" value="{{$ability}}">{{$name}}</label>{{end}}</div></fieldset><button class="ui primary button">创建角色</button></form></details></section>{{end}}
 {{if .State.CanManage}}{{if .State.Archived}}<p>归档或待删除期间只能撤销项目直接授权。</p>{{else}}
  <h3>新增或修改直接授权</h3>
  <form method="post" class="ui form">{{.CsrfTokenHtml}}<input type="hidden" name="revision" value="{{.State.Revision}}">
   <div class="three fields"><div class="field"><label for="member-username">用户名</label><input id="member-username" name="username" required autocomplete="off"></div><div class="field"><label for="member-role">角色</label><select id="member-role" name="role">{{range $role,$name := .RoleNames}}{{if ne $role 50}}<option value="{{$role}}" {{if eq $role 20}}selected{{end}}>{{$name}}</option>{{end}}{{end}}</select></div><div class="field"><label for="member-expiry">有效至（UTC 日期，留空为永久）</label><input id="member-expiry" name="expires" type="date"></div></div>
   <div class="field"><label for="member-custom">自定义角色（基础角色须与所选角色一致）</label><select id="member-custom" name="custom_role_id"><option value="0">使用标准角色</option>{{range .State.Roles}}{{if ne .BaseRole 50}}<option value="{{.ID}}">{{.Name}} · {{index $.RoleNames .BaseRole}}</option>{{end}}{{end}}</select></div>
   <button class="ui primary button" name="action" value="save">保存直接授权</button>
  </form>
 {{end}}{{end}}
</div></div>
{{template "base/footer" .}}
