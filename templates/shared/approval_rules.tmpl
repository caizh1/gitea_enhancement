 <h2 class="ui dividing header">{{if .PolicyMode}}强制审批策略{{else}}{{if .PullMode}}PR {{if not .PullUsesProjectRules}}独立{{end}}{{end}}审批规则{{end}} · {{.State.FullPath}}</h2>
 {{template "base/alert" .}}
 {{if .State.MergeEnforcementReady}}<div class="ui positive message">原生合并入口已在最终写入前重新检查审批规则。</div>{{end}}
 {{if and (not .PolicyMode) (not .PullMode) (not .State.ReferenceEnforcementReady)}}<div class="ui warning message">目标仓库尚未安装并验证引用事务入口。已有第三方入口时安装会安全拒绝并保留原文件。{{if .State.CanManage}}<form method="post" class="tw-mt-2">{{$.CsrfTokenHtml}}<input type="hidden" name="action" value="install_reference_hook"><button class="ui primary button" type="submit">安装并验证引用事务入口</button></form>{{end}}</div>{{end}}
 <p>每条必需规则都必须满足。同一人在一条规则内只计一票，符合多条规则时可以同时满足它们。人数为 0 的规则属于可选审批。</p>
 {{if .PullMode}}
 <h3 class="ui dividing header">当前批准情况</h3>
 {{if .EvaluationError}}<div class="ui warning message">{{.EvaluationError}}</div>{{else if .ApprovalEvaluation.VersionReady}}
  <p>差异版本 {{.ApprovalEvaluation.State.Generation}} · {{if .ApprovalEvaluation.State.Satisfied}}当前审批要求已满足{{else}}尚有审批要求未满足{{end}}</p>
  <div class="flex-list">{{range .ApprovalEvaluation.State.Rules}}<div class="flex-item tw-flex-wrap"><div class="flex-item-main tw-min-w-0"><strong>{{.Name}}</strong><div>{{if .Optional}}可选审批{{else if and .NeedsAttention (not .SubjectsHidden)}}需要处理：合格人员不足{{else if .Satisfied}}已满足{{else}}还需 {{.Missing}} 人批准{{end}}</div><div>{{if .SubjectsHidden}}审批主体及批准人对你不可见{{else}}已批准：{{range .ApprovedUserIDs}}<span class="ui label">{{or (index $.UserNames .) "不可用或不可见的审批人"}}</span>{{else}}暂无{{end}}{{end}}</div><div>{{if SliceUtils.Contains $.ApprovalEvaluation.EligibleRuleIDs .ID}}你可以为此规则批准{{else}}你当前不属于此规则的合格审批人{{end}}</div></div></div>{{end}}</div>
 {{else}}<p>{{.ApprovalEvaluation.Reason}}</p>{{end}}
 {{end}}
 <div class="flex-list">{{range .State.Rules}}
  <div class="flex-item tw-flex-wrap"><div class="flex-item-main tw-min-w-0"><strong>{{.Name}}</strong>
   <div>{{if .Enabled}}{{if .Required}}必需 · 至少 {{.Required}} 人{{else}}可选审批{{end}}{{else}}已停用{{end}} · {{if eq .ScopeType "pull"}}PR 独立规则{{else if eq .ScopeType "repository"}}项目规则{{else if eq .ScopeType "instance"}}实例策略{{else}}群组策略{{end}}</div>
   <div>{{range .UserIDs}}<span class="ui label">{{or (index $.UserNames .) "不可用或不可见的审批人"}}</span>{{end}}{{range .GroupIDs}}<span class="ui label">{{or (index $.GroupNames .) "不可用或不可见的群组"}}</span>{{end}}{{if .TeamIDs}}<span class="ui label">历史审批要求（兼容保留）</span>{{end}}{{if .AllEligible}}全部合格审批人，按不同用户计算总人数{{end}}{{if .RespectNativeApprovalPool}} · 同时遵循目标分支原生审批资格池{{end}}</div>
  </div>{{if and $.State.CanManage (eq .ScopeType $.EditableScope)}}
   <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-2"><a class="ui basic button" href="?edit={{.ID}}">编辑</a><form method="post">{{$.CsrfTokenHtml}}<input type="hidden" name="rule_id" value="{{.ID}}"><input type="hidden" name="revision" value="{{if $.PullMode}}{{$.PullRuleRevision}}{{else}}{{.Revision}}{{end}}"><button class="ui red basic button" name="action" value="remove">删除</button></form></div>
  {{end}}</div>{{else}}<p>暂无审批规则。</p>{{end}}</div>
 {{if .State.CanManage}}
 {{if not .PullMode}}<h3 class="ui dividing header">审批设置</h3>
 <form class="ui form" method="post">{{.CsrfTokenHtml}}<input type="hidden" name="revision" value="{{.State.SettingsRevision}}">
  {{range $name,$source := .State.Settings.Sources}}{{$locked := and $source.Locked (not (and $.PolicyMode (eq $source.ScopeType $.EditableScope) (eq $source.ScopeID $.RepositoryID)))}}<div class="field">
   {{if and $locked $source.Value}}<input type="hidden" name="{{$name}}" value="true">{{end}}
   <label><input type="checkbox" name="{{$name}}" value="true" {{if $source.Value}}checked{{end}} {{if or $locked (and (eq $name "require_reauthentication") (not $.CanReauthenticateApproval))}}disabled{{end}}> {{index $.SettingLabels $name}}</label>
   {{if $locked}}<p>由{{if eq $source.ScopeType "instance"}}实例{{else}}上级群组{{end}}锁定，需在授权来源修改。</p>{{end}}
   {{if and (eq $name "require_reauthentication") (not $.CanReauthenticateApproval)}}<p>当前账号没有可用的密码再次认证方式，不能启用。</p>{{end}}
  </div>{{end}}
  {{if and .PolicyMode (eq .EditableScope "group")}}<div class="field"><label><input type="checkbox" name="locked" value="true" {{if .ScopeSettingsLocked}}checked{{end}}> 锁定全部设置，后代项目必须使用这些值</label></div>{{end}}
  <div class="tw-flex tw-flex-wrap tw-gap-2"><button class="ui primary button" name="action" value="settings">保存审批设置</button>{{if and .PolicyMode .HasLocalSettings}}<button class="ui basic button" name="action" value="inherit_settings">移除本级设置，恢复继承</button>{{end}}</div>
 </form>
 {{end}}<h3 class="ui dividing header">{{if .Edited.ID}}编辑规则{{else}}新增规则{{end}}</h3>
 <form class="ui form" method="post">{{.CsrfTokenHtml}}<input type="hidden" name="rule_id" value="{{.Edited.ID}}"><input type="hidden" name="revision" value="{{if .PullMode}}{{.PullRuleRevision}}{{else}}{{.Edited.Revision}}{{end}}">
  <div class="two fields"><div class="field"><label for="approval-name">规则名称</label><input id="approval-name" name="name" value="{{.Edited.Name}}" maxlength="100" required></div><div class="field"><label for="approval-count">所需人数（0 为可选）</label><input id="approval-count" type="number" name="required" value="{{.Edited.Required}}" min="0" max="100" required></div></div>
  <div class="three fields">
   <div class="field"><label for="approval-users">候选审批人（可多选）</label><select id="approval-users" name="users" multiple size="6">{{range .Choices.Users}}<option value="{{.ID}}" {{if index $.SelectedUsers .ID}}selected{{end}}>{{.Name}}</option>{{end}}</select><p>普通模式从候选池中满足所需人数；如需每个人都批准，请使用下方“所选人员逐人必批”。</p></div>
   <div class="field"><label for="approval-groups">审批群组（仅直接成员）</label><select id="approval-groups" name="groups" multiple size="6">{{range .Choices.Groups}}<option value="{{.ID}}" {{if index $.SelectedGroups .ID}}selected{{end}}>{{.Name}}</option>{{end}}</select></div>
{{range .Edited.TeamIDs}}<input type="hidden" name="teams" value="{{.}}">{{end}}
  </div>
  {{if and (not .PullMode) (not .PolicyMode) (not .Edited.ID)}}<div class="field"><label><input type="checkbox" name="every_person" value="true"> 所选人员逐人必批：为每个人创建独立单人规则（不能同时选择群组或团队）</label></div>{{end}}
  <div class="field"><label><input type="checkbox" name="all_eligible" value="true" {{if .Edited.AllEligible}}checked{{end}}> 按全部合格审批人计算去重总人数</label></div>
  <div class="field"><label><input type="checkbox" name="respect_native_approval_pool" value="true" {{if .Edited.RespectNativeApprovalPool}}checked{{end}}> 同时限制为目标分支当前的原生审批白名单；未启用原生白名单时要求代码写权限</label></div>
  <div class="two fields"><div class="field"><label for="approval-scope">目标分支范围</label><select id="approval-scope" name="branch_mode"><option value="all" {{if eq .Edited.BranchMode "all"}}selected{{end}}>全部分支</option><option value="protected" {{if eq .Edited.BranchMode "protected"}}selected{{end}}>全部保护分支</option><option value="branches" {{if eq .Edited.BranchMode "branches"}}selected{{end}}>指定保护分支</option><option value="protection_rules" {{if eq .Edited.BranchMode "protection_rules"}}selected{{end}}>指定保护分支规则</option></select></div><div class="field"><label for="approval-branches">分支或保护规则名称（每行一个）</label><textarea id="approval-branches" name="branches" rows="3">{{.BranchText}}</textarea></div></div>
  <div class="field"><label><input type="checkbox" name="enabled" value="true" {{if .Edited.Enabled}}checked{{end}}> 启用此规则</label></div>
  <div class="tw-flex tw-flex-wrap tw-gap-2"><button class="ui primary button" type="submit">保存规则</button>{{if .Edited.ID}}<a class="ui button" href="?">取消编辑</a>{{end}}</div>
 </form>{{else}}<p>当前权限、PR 状态或上级设置不允许修改这些规则。</p>{{end}}
